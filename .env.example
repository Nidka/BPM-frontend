# Variables públicas/servidor web. Nunca introducir credenciales aquí.
API_BASE_URL=https://bpm-service-production.up.railway.app
# Por defecto se usa config/firebase.public.json. Override opcional:
# FIREBASE_API_KEY=<Web API Key pública de otro entorno>
# FIREBASE_API_KEY= deshabilita explícitamente el login en ese entorno.
# Railway asigna PORT automáticamente. Solo desarrollo:
PORT=3000
